    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "1/12 del SBU por mes (y días/30) del período regional; solo si está acumulado (employment.fourteenth_accumulated=true); la región se informa en employment.region."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "all": [
        {
          "left": {
            "input": "employment.fourteenth_accumulated",
            "default": false
          },
          "op": "==",
          "right": true
        },
        {
          "left": {
            "input": "employment.region",
            "default": "SIERRA_AMAZONIA",
            "as": "text"
          },
          "op": "==",
          "right": {
            "value": "SIERRA_AMAZONIA"
          }
        }
      ]
    }
  },
