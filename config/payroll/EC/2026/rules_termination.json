  {
    "rule_id": "EC.DECIMO_TERCERO.1",
    "rule_key": "EC.DECIMO_TERCERO",
    "version": "1",
    "country": "EC",
    "jurisdiction": "NATIONAL",
    "concept": "EC_DECIMO_TERCERO",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "fixed_amount_prorated",
      "params": {
        "amount": {
          "line": "EC_T_YEAR_ACCRUED"
        },
        "factor": "1/12"
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Comisión de Legislación y Codificación — Código del Trabajo, Codificación 2005-017 (última modificación 22-jun-2020)",
      "legal_reference": "Código del Trabajo art. 111 (decimotercera: doceava parte de las remuneraciones percibidas durante el año calendario; pago mensual o, a pedido escrito, acumulado hasta el 24 de diciembre)",
      "official_url": "https://www.uafe.gob.ec/wp-content/uploads/downloads/2020/04/A2-CODIGO-DEL-TRABAJO.pdf",
      "verified_at": "2026-09-24",
      "note": "La copia consultada tiene última modificación 2020: las reformas posteriores no se verificaron."
    },
    "verification": {
      "interpretation_status": "CONFLICTING",
      "professional_validation": "PENDING",
      "note": "El art. 111 codificado dice 'año calendario' (enero-diciembre), mientras los instructivos del Ministerio del Trabajo (Acuerdos 45 y 87 de 2015, no consultados) usan el período 1-dic a 30-nov. Se aplica el texto del Código: PENDING_VERIFICATION. Solo si el trabajador pidió acumularlo (employment.thirteenth_accumulated=true); por defecto se paga mensualmente."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "employment.thirteenth_accumulated",
        "default": false
      },
      "op": "==",
      "right": true
    }
  },
  {
