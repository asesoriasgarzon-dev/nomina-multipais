    ],
    "calculation": {
      "mechanism": "fixed_amount_prorated",
      "params": {
        "amount": {
          "base": "CL.VACATION_BASE"
        },
        "factor": "7/5",
        "proration": {
          "type": "FIXED_DIVISOR",
          "divisor": "30",
          "days": {
            "line": "CL_T_VACATION_DAYS_DUE"
          }
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Biblioteca del Congreso Nacional de Chile (Ley Chile) — DFL 1, Código del Trabajo",
      "legal_reference": "Código del Trabajo arts. 67 (15 días hábiles de feriado anual), 68 (un día adicional por cada tres nuevos años tras 10 años de trabajo, hasta 10 años de empleadores anteriores), 69 (el sábado es siempre inhábil), 71 (remuneración íntegra) y 73 (compensación en dinero al terminar; proporcional al tiempo si no completó el año)",
      "official_url": "https://www.bcn.cl/leychile/navegar?idNorma=207436",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "UNREVIEWED",
      "professional_validation": "PENDING",
      "note": "Días hábiles × 7/5 (conversión de lunes-a-viernes a días corridos, porque el sábado es siempre inhábil: art. 69) × remuneración/30. La conversión a días corridos es criterio de la práctica (PENDING_VERIFICATION); debe verificarse contra la Dirección del Trabajo.",
      "open_question": true
    },
    "implementation_status": "PARTIAL"
  },
