[
  {
    "rule_id": "CL.IN.LAST_REMUNERATION.1",
    "rule_key": "CL.IN.LAST_REMUNERATION",
    "version": "1",
    "country": "CL",
    "jurisdiction": "NATIONAL",
    "concept": "CL_T_LAST_MONTHLY_REMUNERATION",
    "category": "TERMINATION_INPUT",
    "kind": "INFO",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "history_value",
      "params": {
        "history_input": "salary_history",
        "method": "AVERAGE_IF_VARIED",
        "window_months": 3,
        "vary_months": 3,
        "fallback": {
          "input": "employment.monthly_salary"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Biblioteca del Congreso Nacional de Chile (Ley Chile) — DFL 1, Código del Trabajo",
      "legal_reference": "Código del Trabajo art. 172: la última remuneración mensual comprende toda cantidad que perciba el trabajador por sus servicios (incluidas cotizaciones de cargo del trabajador y regalías), excluida la asignación familiar, sobretiempo y beneficios esporádicos; variables: promedio de los últimos tres meses; tope de 90 UF del último día del mes anterior al pago",
      "official_url": "https://www.bcn.cl/leychile/navegar?idNorma=207436",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Remuneración fija: la última; variable: promedio de los últimos tres meses calendario. El usuario informa solo conceptos que integran la base (sin asignación familiar, sobretiempo ni pagos esporádicos)."
    },
    "implementation_status": "PARTIAL"
  },
