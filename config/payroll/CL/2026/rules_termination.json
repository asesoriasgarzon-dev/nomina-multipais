  {
    "rule_id": "CL.INDEMNIZACION_ANOS.1",
    "rule_key": "CL.INDEMNIZACION_ANOS",
    "version": "1",
    "country": "CL",
    "jurisdiction": "NATIONAL",
    "concept": "CL_INDEMNIZACION_ANOS_SERVICIO",
    "category": "TERMINATION_INDEMNITY",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "tiered_service_amount",
      "params": {
        "base": {
          "base": "CL.INDEMNITY_BASE"
        },
        "unit_days_per_month": "30",
        "tiers": [
          {
            "over_years": "0",
            "units_per_year": "30",
            "fraction": "THRESHOLD",
            "threshold_months": 6
          }
        ],
        "max_units": "330"
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Biblioteca del Congreso Nacional de Chile (Ley Chile) — DFL 1, Código del Trabajo",
      "legal_reference": "Código del Trabajo art. 163: 30 días de la última remuneración mensual devengada por cada año de servicio y fracción superior a seis meses, tope de 330 días; vigente un año o más; causal art. 161",
      "official_url": "https://www.bcn.cl/leychile/navegar?idNorma=207436",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "30 días de la última remuneración por año y fracción SUPERIOR a seis meses (6 meses y 1 día suma), tope de 330 días, con la base topada a 90 UF (art. 172). Solo causal del art. 161 con contrato de un año o más; la indemnización pactada por las partes (si es mayor) no se modela."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "all": [
        {
          "left": {
            "input": "termination.cause",
            "as": "text"
          },
          "op": "in",
          "right": [
            "DISMISSAL_BUSINESS_NEEDS",
            "DISMISSAL_DESAHUCIO"
          ]
        },
        {
          "left": {
            "service": "COMPLETED_YEARS"
          },
          "op": ">=",
          "right": "1"
        }
      ]
    }
  },
  {
    "rule_id": "CL.AVISO_PREVIO.1",
    "rule_key": "CL.AVISO_PREVIO",
    "version": "1",
    "country": "CL",
    "jurisdiction": "NATIONAL",
    "concept": "CL_INDEMNIZACION_AVISO_PREVIO",
    "category": "TERMINATION_INDEMNITY",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "fixed_amount_prorated",
      "params": {
        "amount": {
          "base": "CL.INDEMNITY_BASE"
        },
        "factor": "1"
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Biblioteca del Congreso Nacional de Chile (Ley Chile) — DFL 1, Código del Trabajo",
      "legal_reference": "Código del Trabajo art. 161 (y 162 inc. 4): aviso de 30 días o indemnización sustitutiva equivalente a la última remuneración mensual devengada (con el tope del art. 172)",
      "official_url": "https://www.bcn.cl/leychile/navegar?idNorma=207436",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Una última remuneración mensual (con el tope de 90 UF) si el empleador no dio aviso con 30 días de anticipación (termination.notice_given=false)."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "all": [
        {
          "left": {
            "input": "termination.cause",
            "as": "text"
          },
          "op": "in",
          "right": [
            "DISMISSAL_BUSINESS_NEEDS",
            "DISMISSAL_DESAHUCIO"
          ]
        },
        {
          "left": {
            "input": "termination.notice_given",
            "default": false
          },
          "op": "==",
          "right": false
        }
      ]
    }
  },
  {
    "rule_id": "CL.IN.VAC_DAYS.1",
    "rule_key": "CL.IN.VAC_DAYS",
    "version": "1",
    "country": "CL",
    "jurisdiction": "NATIONAL",
    "concept": "CL_T_VACATION_DAYS",
    "category": "TERMINATION_INPUT",
    "kind": "INFO",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_quantity",
      "params": {
        "years_basis": "COMPLETED_YEARS_PLUS_PRIOR",
        "prior_cap": "10",
        "linear": {
          "base_quantity": "15",
          "per_completed_year": "1",
          "after_years": 10,
          "block_years": 3
        }
      },
      "rounding": "none"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Biblioteca del Congreso Nacional de Chile (Ley Chile) — DFL 1, Código del Trabajo",
      "legal_reference": "Código del Trabajo arts. 67 (15 días hábiles de feriado anual), 68 (un día adicional por cada tres nuevos años tras 10 años de trabajo, hasta 10 años de empleadores anteriores), 69 (el sábado es siempre inhábil), 71 (remuneración íntegra) y 73 (compensación en dinero al terminar; proporcional al tiempo si no completó el año)",
      "official_url": "https://www.bcn.cl/leychile/navegar?idNorma=207436",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "15 días hábiles; con 10 años de trabajo (para uno o más empleadores, contando hasta 10 años de empleadores anteriores: employment.prior_years) un día adicional por cada tres nuevos años."
    },
    "implementation_status": "PARTIAL"
  },
