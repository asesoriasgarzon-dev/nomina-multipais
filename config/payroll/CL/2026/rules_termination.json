  {
    "rule_id": "CL.FERIADO.1",
    "rule_key": "CL.FERIADO",
    "version": "1",
    "country": "CL",
    "jurisdiction": "NATIONAL",
    "concept": "CL_FERIADO_PROPORCIONAL",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
