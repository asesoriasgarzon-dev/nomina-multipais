  {
    "rule_id": "AR.IN.BEST_REMUNERATION.1",
    "rule_key": "AR.IN.BEST_REMUNERATION",
    "version": "1",
    "country": "AR",
    "jurisdiction": "NATIONAL",
    "concept": "AR_T_BEST_REMUNERATION",
    "category": "TERMINATION_INPUT",
    "kind": "INFO",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "history_value",
      "params": {
        "history_input": "salary_history",
        "method": "MAX",
        "window_months": 12,
        "fallback": {
          "input": "employment.monthly_salary"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "InfoLeg — LCT texto actualizado y Ley 27.802 (B.O. 6-mar-2026)",
      "legal_reference": "LCT art. 245 (texto art. 51 Ley 27.802, vigente desde su publicación): un mes de sueldo por año o fracción mayor de 3 meses sobre la mejor remuneración mensual, normal y habitual del último año; tope de 3 veces el promedio del convenio colectivo aplicable (nunca inferior al 67 % de la remuneración); mínimo de un mes",
      "official_url": "https://servicios.infoleg.gob.ar/infolegInternet/anexos/25000-29999/25552/texact.htm",
      "verified_at": "2026-09-24",
      "note": "El tope depende del convenio colectivo (dato de entrada amounts.cct_average_salary); sin el dato el tope NO se aplica y se emite advertencia."
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Máximo mensual de las remuneraciones informadas del último año (el usuario debe cargar solo conceptos mensuales, normales y habituales: sin SAC, vacaciones ni premios no mensuales). El promedio de variables (6 meses / 1 año) se calcula fuera del motor."
    },
    "implementation_status": "PARTIAL"
  },
