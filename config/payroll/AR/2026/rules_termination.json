  {
    "rule_id": "AR.INDEMNIZACION_245.1",
    "rule_key": "AR.INDEMNIZACION_245",
    "version": "1",
    "country": "AR",
    "jurisdiction": "NATIONAL",
    "concept": "AR_INDEMNIZACION_ART_245",
    "category": "TERMINATION_INDEMNITY",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "tiered_service_amount",
      "params": {
        "base": {
          "base": "AR.INDEMNITY_BASE"
        },
        "unit_days_per_month": "1",
        "tiers": [
          {
            "over_years": "0",
            "units_per_year": "1",
            "fraction": "THRESHOLD",
            "threshold_months": 3
          }
        ],
        "min_units": "1",
        "base_cap": {
          "input": "amounts.cct_average_salary",
          "multiple": "3",
          "floor_share": "0.67"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "InfoLeg — LCT texto actualizado y Ley 27.802 (B.O. 6-mar-2026)",
      "legal_reference": "LCT art. 245 (texto art. 51 Ley 27.802, vigente desde su publicación): un mes de sueldo por año o fracción mayor de 3 meses sobre la mejor remuneración mensual, normal y habitual del último año; tope de 3 veces el promedio del convenio colectivo aplicable (nunca inferior al 67 % de la remuneración); mínimo de un mes",
      "official_url": "https://servicios.infoleg.gob.ar/infolegInternet/anexos/25000-29999/25552/texact.htm",
      "verified_at": "2026-09-24",
      "note": "El tope depende del convenio colectivo (dato de entrada amounts.cct_average_salary); sin el dato el tope NO se aplica y se emite advertencia."
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Un mes por año o fracción MAYOR de 3 meses (3 meses y 1 día suma), mínimo un mes; el tope (3 × promedio del convenio, piso 67 % de la remuneración) exige el dato del convenio."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "all": [
        {
          "left": {
            "input": "termination.cause",
            "as": "text"
          },
          "op": "in",
          "right": [
            "DISMISSAL_WITHOUT_CAUSE"
          ]
        },
        {
          "left": {
            "input": "employment.contract_type",
            "as": "text"
          },
          "op": "in",
          "right": [
            "INDEFINITE"
          ]
        },
        {
          "left": {
            "service": "MONTHS_DECIMAL"
          },
          "op": ">",
          "right": {
            "input": "employment.probation_months",
            "default": "6"
          }
        }
      ]
    }
  },
