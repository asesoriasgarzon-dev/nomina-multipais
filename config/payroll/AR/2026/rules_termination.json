  {
    "rule_id": "AR.IN.SAC_ACCRUED.1",
    "rule_key": "AR.IN.SAC_ACCRUED",
    "version": "1",
    "country": "AR",
    "jurisdiction": "NATIONAL",
    "concept": "AR_T_SAC_ACCRUED",
    "category": "TERMINATION_INPUT",
    "kind": "INFO",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "accrued_in_window",
      "params": {
        "window": {
          "type": "RECURRING_PERIODS",
          "periods": [
            {
              "start": "01-01",
              "end": "06-30"
            },
            {
              "start": "07-01",
              "end": "12-31"
            }
          ]
        },
        "history_input": "salary_history",
        "fallback_monthly": {
          "input": "employment.monthly_salary"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "InfoLeg (Ministerio de Justicia de la Nación) — texto actualizado de la LCT",
      "legal_reference": "LCT art. 123 (SAC en la extinción): 'la doceava parte de las remuneraciones devengadas en la fracción del semestre trabajado, hasta el momento de dejar el servicio'; art. 122 (semestres que culminan en junio y diciembre)",
      "official_url": "https://servicios.infoleg.gob.ar/infolegInternet/anexos/25000-29999/25552/texact.htm",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Suma de las remuneraciones devengadas (historial mensual informado) dentro de la fracción del semestre; sin historial se supone remuneración constante (meses + días/30)."
    },
    "implementation_status": "PARTIAL"
  },
