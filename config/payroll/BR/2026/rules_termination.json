  {
    "rule_id": "BR.FERIAS_PROP.1",
    "rule_key": "BR.FERIAS_PROP",
    "version": "1",
    "country": "BR",
    "jurisdiction": "NATIONAL",
    "concept": "BR_FERIAS_PROPORCIONAIS",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "BR.RESCISSION_BASE"
        },
        "window": {
          "type": "SERVICE_YEAR"
        },
        "count": {
          "unit": "MONTHS_ROUNDED_BY_DAYS",
          "day_threshold": 15,
          "divisor": "12"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Presidência da República — Portal da Legislação (Planalto)",
      "legal_reference": "CLT arts. 129-130 (30 dias por 12 meses), 142 (remuneração devida na data da concessão), 146 (rescisão: remuneração do período adquirido; parágrafo único: proporcional 1/12 por mês ou fração superior a 14 dias, salvo justa causa), 147 (menos de 12 meses); CF art. 7º XVII (um terço a mais)",
      "official_url": "https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452.htm",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "UNREVIEWED",
      "professional_validation": "PENDING",
      "note": "1/12 por mes de servicio o fracción superior a 14 dias del período aquisitivo (art. 146 párrafo único), salvo justa causa. Antes de 12 meses: sin justa causa o contrato a prazo (art. 147); la renuncia antes de 12 meses se incluye por entendimiento del TST (PENDING_VERIFICATION).",
      "open_question": true
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "any": [
        {
          "all": [
            {
              "left": {
                "service": "COMPLETED_YEARS"
              },
              "op": ">=",
              "right": "1"
            },
            {
              "left": {
                "input": "termination.cause",
                "as": "text"
              },
              "op": "not_in",
              "right": [
                "DISMISSAL_WITH_CAUSE"
              ]
            }
          ]
        },
        {
          "all": [
            {
              "left": {
                "service": "COMPLETED_YEARS"
              },
              "op": "<",
              "right": "1"
            },
            {
              "left": {
                "input": "termination.cause",
                "as": "text"
              },
              "op": "in",
              "right": [
                "DISMISSAL_WITHOUT_CAUSE",
                "INDIRECT_DISMISSAL",
                "MUTUAL_AGREEMENT",
                "FIXED_TERM_EXPIRY",
                "RESIGNATION"
              ]
            }
          ]
        }
      ]
    }
  },
  {
