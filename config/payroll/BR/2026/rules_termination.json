  {
    "rule_id": "BR.13O.1",
    "rule_key": "BR.13O",
    "version": "1",
    "country": "BR",
    "jurisdiction": "NATIONAL",
    "concept": "BR_13O_PROPORCIONAL",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "BR.RESCISSION_BASE"
        },
        "window": {
          "type": "CALENDAR_YEAR"
        },
        "count": {
          "unit": "MONTHS_WITH_MIN_DAYS",
          "day_threshold": 15,
          "divisor": "12"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Presidência da República — Portal da Legislação (Planalto)",
      "legal_reference": "Lei 4.090/1962 art. 1º §§1º-3º (1/12 da remuneração por mês de serviço; fração de 15 dias ou mais = mês integral; proporcional nos contratos a prazo e na aposentadoria) e art. 3º (rescisão sem justa causa: calculada sobre a remuneração do mês da rescisão); CF art. 7º VIII",
      "official_url": "https://www.planalto.gov.br/ccivil_03/leis/l4090.htm",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "1/12 por cada mes calendario del año con 15 días o más trabajados (art. 1º §2º). Sin justa causa (art. 3º), contratos a prazo y aposentadoria (art. 1º §3º)."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "termination.cause",
        "as": "text"
      },
      "op": "in",
      "right": [
        "DISMISSAL_WITHOUT_CAUSE",
        "INDIRECT_DISMISSAL",
        "MUTUAL_AGREEMENT",
        "FIXED_TERM_EXPIRY",
        "RETIREMENT",
        "DEATH"
      ]
    }
