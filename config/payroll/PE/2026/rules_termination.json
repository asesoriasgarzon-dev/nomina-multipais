  {
    "rule_id": "PE.CTS_TRUNCA.1",
    "rule_key": "PE.CTS_TRUNCA",
    "version": "1",
    "country": "PE",
    "jurisdiction": "NATIONAL",
    "concept": "PE_CTS_TRUNCA",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "PE.CTS_BASE"
        },
        "window": {
          "type": "RECURRING_PERIODS",
          "periods": [
            {
              "start": "05-01",
              "end": "10-31"
            },
            {
              "start": "11-01",
              "end": "04-30"
            }
          ]
        },
        "count": {
          "unit": "MONTHS_AND_DAYS",
          "months_divisor": "12",
          "days_divisor": "360"
        },
        "min_service": {
          "unit": "MONTHS_AND_DAYS",
          "value": "1"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Ministerio de Trabajo y Promoción del Empleo (MTPE)",
      "legal_reference": "TUO de la Ley de Compensación por Tiempo de Servicios, D.S. 001-97-TR: arts. 2, 9, 10, 18, 21",
      "official_url": "https://cdn.www.gob.pe/uploads/document/file/229267/TUO_Compensacion_por_Tiempo_de_Servicios_-_D.S_001-97-TR.pdf",
      "verified_at": "2026-09-24",
      "note": "Art. 21: 'tantos dozavos de la remuneración computable ... como meses completos haya laborado en el semestre respectivo. La fracción de mes se depositará por treintavos.' Art. 2: se devenga desde el primer mes; cumplido ese requisito toda fracción se computa por treintavos. Art. 18: un sexto de la gratificación semestral se incorpora a la remuneración computable."
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Semestres mayo-octubre y noviembre-abril; dozavos por mes completo y treintavos por día (arts. 2 y 21). La remuneración computable al cese se toma de los datos informados (art. 10 usa abril/octubre para depósitos, no para el cese)."
    },
    "implementation_status": "PARTIAL",
    "notes": "CTS de la fracción de semestre no depositada. No incluye depósitos ya efectuados. Solo trabajadores con jornada mínima de 4 horas (no validado)."
  },
  {
    "rule_id": "PE.GRATIFICACION_TRUNCA.1",
    "rule_key": "PE.GRATIFICACION_TRUNCA",
    "version": "1",
    "country": "PE",
    "jurisdiction": "NATIONAL",
    "concept": "PE_GRATIFICACION_TRUNCA",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "PE.GRATIFICATION_BASE"
        },
        "window": {
          "type": "RECURRING_PERIODS",
          "periods": [
            {
              "start": "01-01",
              "end": "06-30"
            },
            {
              "start": "07-01",
              "end": "12-31"
            }
          ]
        },
        "count": {
          "unit": "MONTHS_COMPLETE_CALENDAR",
          "divisor": "6"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Ministerio de Trabajo y Promoción del Empleo (MTPE)",
      "legal_reference": "D.S. 005-2002-TR (Reglamento de la Ley 27735), art. 3.3 (períodos ene-jun / jul-dic), art. 5 (gratificación trunca)",
      "official_url": "https://www2.congreso.gob.pe/sicr/cendocbib/con4_uibd.nsf/2AD0D0DFA71EA38705257E26005C8083/$FILE/2_DECRETO_SUPREMO_005_04_07_2002.pdf",
      "verified_at": "2026-09-24",
      "note": "Art. 5: derecho a la gratificación trunca al cese con al menos un mes íntegro de servicios; monto proporcional a los meses calendario completos laborados en el período; remuneración computable vigente al mes inmediato anterior al cese."
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Un sexto de la remuneración por cada mes calendario COMPLETO del semestre (ene-jun / jul-dic). Los días no laborados se deducen a un treintavo (DS 017-2002-TR) y no se modelan."
    },
    "implementation_status": "PARTIAL",
    "notes": "La gratificación trunca NO usa la fórmula de la CTS: ventana y unidad de conteo distintas."
  },
  {
    "rule_id": "PE.BONIFICACION_EXTRAORDINARIA.1",
