    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Ministerio de Trabajo y Promoción del Empleo (MTPE)",
      "legal_reference": "D.S. 012-92-TR (Reglamento del D.Leg. 713), arts. 16 y 23",
      "official_url": "https://www2.congreso.gob.pe/sicr/cendocbib/con4_uibd.nsf/0D48067F03F11D1405257E23005CE18D/$FILE/2_DECRETO_SUPREMO_012_03_12_92.pdf",
      "verified_at": "2026-09-24",
      "note": "Art. 23: el récord trunco procede con un mes de servicios y se compensa a razón de tantos dozavos y treintavos de la remuneración como meses y días computables. Art. 16: la remuneración vacacional es la computable para CTS, salvo las periódicas del art. 18 del D.Leg. 650."
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Récord trunco del año de servicio en curso (desde el último aniversario del ingreso)."
    },
    "implementation_status": "PARTIAL"
  },
  {
