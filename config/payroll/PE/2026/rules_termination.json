    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Congreso de la República del Perú",
      "legal_reference": "Ley 30334: bonificación extraordinaria no remunerativa (9 % para EsSalud)",
      "official_url": "https://www.leyes.congreso.gob.pe/Documentos/Leyes/30334.pdf",
      "verified_at": "2026-09-24",
      "note": "Se verificó por resumen que la gratificación de julio/diciembre no está afecta y que la bonificación es 9 % (EsSalud). Que la gratificación TRUNCA genere también la bonificación no se verificó."
    },
    "verification": {
      "interpretation_status": "UNREVIEWED",
      "professional_validation": "PENDING",
      "note": "9 % solo para trabajadores con EsSalud; EPS (6,75 %) NOT_IMPLEMENTED. Aplicación a la gratificación trunca: PENDING_VERIFICATION.",
      "open_question": true
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "employment.health_scheme",
        "default": "ESSALUD",
        "as": "text"
      },
      "op": "==",
      "right": {
        "value": "ESSALUD"
      }
    }
  },
  {
