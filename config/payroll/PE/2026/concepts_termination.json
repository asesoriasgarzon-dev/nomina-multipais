      },
      {
        "base": "PE.INDEMNITY_BASE",
        "mode": "INCLUDE"
      }
    ],
    "source": {
      "status": "OFFICIAL",
      "authority": "Ministerio de Trabajo y Promoción del Empleo (MTPE)",
      "legal_reference": "TUO de la Ley de Compensación por Tiempo de Servicios, D.S. 001-97-TR: arts. 2, 9, 10, 18, 21",
      "official_url": "https://cdn.www.gob.pe/uploads/document/file/229267/TUO_Compensacion_por_Tiempo_de_Servicios_-_D.S_001-97-TR.pdf",
      "verified_at": "2026-09-24",
      "note": "Art. 21: 'tantos dozavos de la remuneración computable ... como meses completos haya laborado en el semestre respectivo. La fracción de mes se depositará por treintavos.' Art. 2: se devenga desde el primer mes; cumplido ese requisito toda fracción se computa por treintavos. Art. 18: un sexto de la gratificación semestral se incorpora a la remuneración computable."
    },
    "verification": {
      "interpretation_status": "UNREVIEWED",
      "professional_validation": "PENDING"
    },
    "note": "Art. 9 TUO CTS: remuneración básica y todo lo que regularmente perciba el trabajador."
  },
