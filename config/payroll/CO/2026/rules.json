  {
    "rule_id": "CO.TRANSPORT_ALLOWANCE.1",
    "rule_key": "CO.TRANSPORT_ALLOWANCE",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "TRANSPORT_ALLOWANCE",
    "category": "LABOR_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "period_end",
    "straddle_policy": "ERROR",
    "priority": 100,
    "calculation": {
      "mechanism": "fixed_amount_prorated",
      "params": {
        "amount": {
          "reference": {
            "code": "TRANSPORT_ALLOWANCE"
          }
        },
        "proration": {
          "type": "THIRTY_DAY_MONTH",
          "days": {
            "input": "time.worked_days"
          }
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Presidencia de la República",
      "legal_reference": "Decreto 1470 de 2025 art. 1: trabajadores que devengan hasta 2 SMMLV",
      "official_url": "https://www.cancilleria.gov.co/normograma/compilacion/docs/decreto_1470_2025.htm",
      "verified_at": "2026-09-24",
      "publication_date": "2025-12-29"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Se compara el salario mensual contractual con 2 SMMLV (inclusive). Tratamiento de variables, días de vacaciones/incapacidad y periodos parciales: PENDING_VERIFICATION."
    },
    "implementation_status": "IMPLEMENTED",
    "conditions": {
      "left": {
        "input": "employment.monthly_salary"
      },
      "op": "<=",
      "right": {
        "reference": {
          "code": "SMMLV",
          "multiple": "2"
        }
      }
    },
    "notes": "Elegible si salario <= 2 SMMLV; monto fijo mensual prorrateado por días trabajados (base 30)."
  },
