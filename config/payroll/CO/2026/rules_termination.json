  {
    "rule_id": "CO.IN.SALARY_12M.1",
    "rule_key": "CO.IN.SALARY_12M",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "CO_T_SALARY_12M",
    "category": "TERMINATION_INPUT",
    "kind": "INFO",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "history_value",
      "params": {
        "history_input": "salary_history",
        "method": "AVERAGE_IF_VARIED",
        "window_months": 12,
        "vary_months": 3,
        "fallback": {
          "input": "employment.monthly_salary"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Secretaría del Senado de la República (compilación oficial del CST)",
      "legal_reference": "CST arts. 249 (cesantías: un mes de salario por año y proporcionalmente por fracción) y 253 (base: último salario o promedio del último año si varió en los 3 últimos meses o es variable)",
      "official_url": "https://www.secretariasenado.gov.co/senado/basedoc/codigo_sustantivo_trabajo.html",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Art. 253 CST: último salario mensual si no varió en los 3 últimos meses; si varió o es variable, promedio del último año o del tiempo servido. Sin historial se usa el salario contractual vigente."
    },
    "implementation_status": "PARTIAL"
  },
