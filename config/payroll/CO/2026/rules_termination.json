  {
    "rule_id": "CO.CESANTIAS.1",
    "rule_key": "CO.CESANTIAS",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "CO_CESANTIAS",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "CO.CESANTIAS_BASE"
        },
        "window": {
          "type": "CALENDAR_YEAR"
        },
        "count": {
          "unit": "DAYS_360",
          "divisor": "360"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Secretaría del Senado de la República (compilación oficial del CST)",
      "legal_reference": "CST arts. 249 (cesantías: un mes de salario por año y proporcionalmente por fracción) y 253 (base: último salario o promedio del último año si varió en los 3 últimos meses o es variable)",
      "official_url": "https://www.secretariasenado.gov.co/senado/basedoc/codigo_sustantivo_trabajo.html",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "Un mes de salario por año, proporcional por días base 360 (convención comercial: fin de mes = 30) desde el 1-ene (o el ingreso). No liquida años anteriores no consignados (se informan en amounts.cesantias_unpaid_prior). Salario integral: no aplica."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "employment.salary_type",
        "default": "ORDINARY",
        "as": "text"
      },
      "op": "==",
      "right": {
        "value": "ORDINARY"
      }
    },
    "notes": "Salario integral: no causa cesantías (CST art. 132 num. 2: el salario integral compensa prestaciones)."
  },
  {
    "rule_id": "CO.CESANTIAS_INTERESES.1",
    "rule_key": "CO.CESANTIAS_INTERESES",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "CO_CESANTIAS_INTERESES",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "fixed_amount_prorated",
      "params": {
        "amount": {
          "line": "CO_CESANTIAS"
        },
        "factor": "0.12",
        "proration": {
          "type": "FIXED_DIVISOR",
          "divisor": "360",
          "days": {
            "line": "CO_T_DAYS_YEAR"
          }
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "PENDING",
      "authority": null,
      "legal_reference": null,
      "official_url": null,
      "verified_at": null,
      "note": "Ley 52 de 1975: intereses de cesantías 12 % anual sobre lo acumulado, proporcionales a la fracción. Texto no consultado en esta ejecución (la URL de la Secretaría del Senado devolvió 404): PENDING_VERIFICATION."
    },
    "verification": {
      "interpretation_status": "UNREVIEWED",
      "professional_validation": "PENDING",
      "note": "12 % anual sobre las cesantías del período, por días/360 (Ley 52/1975): fuente PENDING."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "employment.salary_type",
        "default": "ORDINARY",
        "as": "text"
      },
      "op": "==",
      "right": {
        "value": "ORDINARY"
      }
    }
  },
  {
    "rule_id": "CO.PRIMA.1",
    "rule_key": "CO.PRIMA",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "CO_PRIMA",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "CO.PRIMA_BASE"
        },
        "window": {
          "type": "RECURRING_PERIODS",
          "periods": [
            {
              "start": "01-01",
              "end": "06-30"
            },
            {
              "start": "07-01",
              "end": "12-31"
            }
          ]
        },
        "count": {
          "unit": "DAYS_360",
          "divisor": "360"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Secretaría del Senado de la República (compilación oficial del CST)",
      "legal_reference": "CST art. 306 (modificado Ley 1788/2016): prima de servicios, 30 días de salario por año, por todo el semestre trabajado o proporcionalmente al tiempo trabajado",
      "official_url": "https://www.secretariasenado.gov.co/senado/basedoc/codigo_sustantivo_trabajo.html",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "30 días de salario por año => salario × días/360 sobre el semestre en curso (ene-jun / jul-dic). Salario integral: no aplica."
    },
    "implementation_status": "PARTIAL",
    "conditions": {
      "left": {
        "input": "employment.salary_type",
        "default": "ORDINARY",
        "as": "text"
      },
      "op": "==",
      "right": {
        "value": "ORDINARY"
      }
    }
  },
  {
    "rule_id": "CO.VACACIONES_PROP.1",
    "rule_key": "CO.VACACIONES_PROP",
    "version": "1",
    "country": "CO",
    "jurisdiction": "NATIONAL",
    "concept": "CO_VACACIONES_PROPORCIONALES",
    "category": "TERMINATION_BENEFIT",
    "kind": "EARNING",
    "effective": {
      "from": "2026-01-01",
      "to": null
    },
    "anchor": "termination_date",
    "straddle_policy": "ERROR",
    "priority": 100,
    "run_types": [
      "TERMINATION"
    ],
    "calculation": {
      "mechanism": "service_period_proration",
      "params": {
        "base": {
          "base": "CO.VACATION_BASE"
        },
        "window": {
          "type": "SERVICE_YEAR"
        },
        "count": {
          "unit": "DAYS_360",
          "divisor": "720"
        }
      },
      "rounding": "currency"
    },
    "source": {
      "status": "OFFICIAL",
      "authority": "Secretaría del Senado de la República (compilación oficial del CST)",
      "legal_reference": "CST arts. 186 (15 días hábiles por año), 189, 192 (remuneración: salario ordinario del día en que inicia el goce; variable: promedio) y 190",
      "official_url": "https://www.secretariasenado.gov.co/senado/basedoc/codigo_sustantivo_trabajo.html",
      "verified_at": "2026-09-24"
    },
    "verification": {
      "interpretation_status": "INTERPRETED",
      "professional_validation": "PENDING",
      "note": "15 días hábiles por año de servicio: días/360 × 15 días × salario/30 = salario × días/720, contados desde el último aniversario. Aplica también a salario integral (sobre el salario integral completo: interpretación sin revisar)."
    },
    "implementation_status": "PARTIAL"
  },
